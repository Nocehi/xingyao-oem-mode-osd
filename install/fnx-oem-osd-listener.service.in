# xingyao-oem-mode-osd managed user unit v1
# fnx-oem-osd listener — journal observer that drives the OSD via
# Quickshell IPC. Template; placeholders are substituted by install/install.sh.
# Inert: nothing enables/starts/reloads this unit.
[Unit]
Description=Fn+X OEM mode listener (journal observer -> OSD IPC)
After=graphical-session.target fnx-oem-osd-osd.service
Wants=fnx-oem-osd-osd.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=:@ENV_BIN@ -- @LISTENER_BIN@ --qs-bin @QS_BIN@ --qml-path @QML_PATH@
Restart=on-failure
RestartSec=2
# Unsupported hardware/configuration and unavailable journal permissions do
# not become a restart loop. A normal runtime fault remains restartable.
RestartPreventExitStatus=77 78

[Install]
WantedBy=default.target
